@model List<ResultProjectDto>

@{
    ViewData["Title"] = "Proje Listesi";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

@functions {
    private static string ResolveProjectImageUrl(string? imageUrl)
    {
        const string fallbackImageUrl =
            "/templates/assets/imgs/page/homepage1/img.png";

        if (string.IsNullOrWhiteSpace(imageUrl))
        {
            return fallbackImageUrl;
        }

        var value = imageUrl.Trim();
        if (value.StartsWith("//", StringComparison.Ordinal))
        {
            return fallbackImageUrl;
        }

        if (value.StartsWith("~/", StringComparison.Ordinal))
        {
            return value[1..];
        }

        if (value.StartsWith("/", StringComparison.Ordinal))
        {
            return value;
        }

        if (Uri.TryCreate(value, UriKind.Absolute, out var absoluteUri))
        {
            return absoluteUri.Scheme is "http" or "https"
                ? value
                : fallbackImageUrl;
        }

        return $"/{value.Replace('\\', '/').TrimStart('/')}";
    }
}

<div class="page-content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <h4 class="card-title mb-0">Proje Listesi</h4>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-bordered table-hover align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>Görsel</th>
                                        <th>Başlık</th>
                                        <th>Açıklama</th>
                                        <th>Durum</th>
                                        <th>İşlemler</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model)
                                    {
                                        <tr>
                                            <td>
                                                <img src="@ResolveProjectImageUrl(item.ImageUrl)"
                                                     alt="@item.Title"
                                                     class="img-thumbnail"
                                                     style="width: 96px; height: 64px; object-fit: cover;" />
                                            </td>
                                            <td>@item.Title</td>
                                            <td>@item.Description</td>
                                            <td>
                                                @if (item.Status)
                                                {
                                                    <span class="badge bg-success">Aktif</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary">Pasif</span>
                                                }
                                            </td>
                                            <td>
                                                <a asp-controller="Project"
                                                   asp-action="UpdateProject"
                                                   asp-route-id="@item.ProjectId"
                                                   class="btn btn-sm btn-primary">
                                                    Güncelle
                                                </a>
                                                <form asp-controller="Project"
                                                      asp-action="DeleteProject"
                                                      method="post"
                                                      class="d-inline"
                                                      onsubmit="return confirm('Bu kaydı silmek istediğinize emin misiniz?');">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@item.ProjectId" />
                                                    <button type="submit"
                                                            class="btn btn-sm btn-danger"
                                                            aria-label="Proje kaydını sil">
                                                        Sil
                                                    </button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                    @if (Model.Count == 0)
                                    {
                                        <tr>
                                            <td colspan="5" class="text-center">
                                                Kayıt bulunamadı.
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <a asp-controller="Project"
                           asp-action="CreateProject"
                           class="btn btn-success mt-3">
                            Yeni Proje Ekle
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
