@model List<ResultHowItWorksDto>

@{
    ViewData["Title"] = "How It Works Listesi";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="page-content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <h4 class="card-title mb-0">How It Works Listesi</h4>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-bordered table-hover align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>Başlık</th>
                                        <th>Açıklama</th>
                                        <th>Görsel</th>
                                        <th>İşlemler</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model)
                                    {
                                        <tr>
                                            <td>@item.Title</td>
                                            <td>@item.Description</td>
                                            <td>
                                                <img src="@item.ImageUrl"
                                                     alt="@item.Title"
                                                     class="img-thumbnail"
                                                     style="width: 96px; height: 64px; object-fit: cover;" />
                                            </td>
                                            <td>
                                                <a asp-controller="HowItWorks"
                                                   asp-action="UpdateHowItWorks"
                                                   asp-route-id="@item.HowItWorksId"
                                                   class="btn btn-sm btn-primary">
                                                    Güncelle
                                                </a>
                                                <a asp-controller="HowItWorks"
                                                   asp-action="DeleteHowItWorks"
                                                   asp-route-id="@item.HowItWorksId"
                                                   class="btn btn-sm btn-danger"
                                                   onclick="return confirm('Bu çalışma adımını silmek istediğinizden emin misiniz?')">
                                                    Sil
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                    @if (Model.Count == 0)
                                    {
                                        <tr>
                                            <td colspan="4" class="text-center">Kayıt bulunamadı.</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <a asp-controller="HowItWorks"
                           asp-action="CreateHowItWorks"
                           class="btn btn-success mt-3">
                            Yeni Kayıt Ekle
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
