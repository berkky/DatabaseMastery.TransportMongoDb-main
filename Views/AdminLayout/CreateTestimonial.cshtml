@model CreateTestimonialDto

@{
    ViewData["Title"] = "Müşteri Yorumu Ekle";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="page-content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <h4 class="card-title mb-0">Müşteri Yorumu Ekle</h4>
                    </div>
                    <div class="card-body">
                        <form asp-controller="Testimonial"
                              asp-action="CreateTestimonial"
                              method="post">
                            <div asp-validation-summary="ModelOnly"
                                 class="text-danger mb-3"></div>

                            <div class="mb-3">
                                <label asp-for="NameSurname" class="form-label">
                                    Ad Soyad
                                </label>
                                <input asp-for="NameSurname" class="form-control" />
                                <span asp-validation-for="NameSurname"
                                      class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Title" class="form-label">
                                    Ünvan / Şirket
                                </label>
                                <input asp-for="Title" class="form-control" />
                                <span asp-validation-for="Title"
                                      class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="ImageUrl" class="form-label">
                                    Görsel Web Yolu
                                </label>
                                <input asp-for="ImageUrl"
                                       class="form-control"
                                       placeholder="/templates/assets/imgs/page/homepage1/author.png" />
                                <span asp-validation-for="ImageUrl"
                                      class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="ReviewDetail" class="form-label">
                                    Müşteri Yorumu
                                </label>
                                <textarea asp-for="ReviewDetail"
                                          class="form-control"
                                          rows="5"></textarea>
                                <span asp-validation-for="ReviewDetail"
                                      class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="ReviewScore" class="form-label">
                                    Puan
                                </label>
                                <input asp-for="ReviewScore"
                                       class="form-control"
                                       type="number"
                                       min="1"
                                       max="5" />
                                <span asp-validation-for="ReviewScore"
                                      class="text-danger"></span>
                            </div>

                            <div class="form-check mb-3">
                                <input asp-for="Status" class="form-check-input" />
                                <label asp-for="Status" class="form-check-label">
                                    Ana sayfada göster
                                </label>
                            </div>

                            <button type="submit" class="btn btn-success">
                                Kaydet
                            </button>
                            <a asp-controller="Testimonial"
                               asp-action="TestimonialList"
                               class="btn btn-secondary">
                                İptal
                            </a>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
