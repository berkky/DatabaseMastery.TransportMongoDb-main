@model List<ResultTestimonialDto>

@{
    ViewData["Title"] = "Müşteri Yorumları";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

@functions {
    private static string ResolveTestimonialImageUrl(string? imageUrl)
    {
        const string fallbackImageUrl =
            "/templates/assets/imgs/page/homepage1/author.png";

        if (string.IsNullOrWhiteSpace(imageUrl))
        {
            return fallbackImageUrl;
        }

        var value = imageUrl.Trim();
        if (value.StartsWith("//", StringComparison.Ordinal))
        {
            return fallbackImageUrl;
        }

        if (value.StartsWith("/", StringComparison.Ordinal))
        {
            return value;
        }

        if (value.StartsWith("~/", StringComparison.Ordinal))
        {
            return value[1..];
        }

        if (Uri.TryCreate(value, UriKind.Absolute, out var absoluteUri))
        {
            return absoluteUri.Scheme is "http" or "https"
                ? value
                : fallbackImageUrl;
        }

        return $"/{value.Replace('\\', '/').TrimStart('/')}";
    }
}

<div class="page-content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <h4 class="card-title mb-0">Müşteri Yorumları</h4>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-bordered table-hover align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>Müşteri</th>
                                        <th>Yorum</th>
                                        <th>Puan</th>
                                        <th>Durum</th>
                                        <th>İşlemler</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model)
                                    {
                                        <tr>
                                            <td>
                                                <div class="d-flex align-items-center gap-2">
                                                    <img src="@ResolveTestimonialImageUrl(item.ImageUrl)"
                                                         alt="@item.NameSurname"
                                                         class="rounded-circle"
                                                         style="width: 48px; height: 48px; object-fit: cover;" />
                                                    <div>
                                                        <div class="fw-semibold">@item.NameSurname</div>
                                                        <small class="text-muted">@item.Title</small>
                                                    </div>
                                                </div>
                                            </td>
                                            <td>@item.ReviewDetail</td>
                                            <td>@item.ReviewScore / 5</td>
                                            <td>
                                                @if (item.Status)
                                                {
                                                    <span class="badge bg-success">Aktif</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary">Pasif</span>
                                                }
                                            </td>
                                            <td>
                                                <a asp-controller="Testimonial"
                                                   asp-action="UpdateTestimonial"
                                                   asp-route-id="@item.TestimonialId"
                                                   class="btn btn-sm btn-primary">
                                                    Güncelle
                                                </a>
                                                <a asp-controller="Testimonial"
                                                   asp-action="DeleteTestimonial"
                                                   asp-route-id="@item.TestimonialId"
                                                   class="btn btn-sm btn-danger"
                                                   onclick="return confirm('Bu müşteri yorumunu silmek istediğinizden emin misiniz?')">
                                                    Sil
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                    @if (Model.Count == 0)
                                    {
                                        <tr>
                                            <td colspan="5" class="text-center">
                                                Kayıt bulunamadı.
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <a asp-controller="Testimonial"
                           asp-action="CreateTestimonial"
                           class="btn btn-success mt-3">
                            Yeni Yorum Ekle
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
