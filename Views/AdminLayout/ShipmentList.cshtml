@model List<ResultShipmentDto>

@{
    ViewData["Title"] = "Gönderi Listesi";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="page-content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <h4 class="card-title mb-0">Gönderi Listesi</h4>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-bordered table-hover align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>Takip No</th>
                                        <th>Gönderici</th>
                                        <th>Alıcı</th>
                                        <th>Güzergâh</th>
                                        <th>Oluşturma Tarihi</th>
                                        <th>Durum</th>
                                        <th>İşlemler</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model is null || Model.Count == 0)
                                    {
                                        <tr>
                                            <td colspan="7" class="text-center">
                                                Kayıt bulunamadı.
                                            </td>
                                        </tr>
                                    }
                                    else
                                    {
                                        @foreach (var item in Model)
                                        {
                                            <tr>
                                                <td>@item.TrackingNumber</td>
                                                <td>@item.SenderName</td>
                                                <td>@item.ReceiverName</td>
                                                <td>
                                                    <div>@item.DepartureCity, @item.DepartureDistrict</div>
                                                    <div class="small text-muted">
                                                        @item.ArrivalCity, @item.ArrivalDistrict
                                                    </div>
                                                </td>
                                                <td>@item.CreatedDate.ToString("dd.MM.yyyy HH:mm")</td>
                                                <td>
                                                    <span class="badge bg-primary">@item.CurrentStatus</span>
                                                </td>
                                                <td>
                                                    <a asp-controller="Shipment"
                                                       asp-action="UpdateShipment"
                                                       asp-route-id="@item.ShipmentId"
                                                       class="btn btn-sm btn-primary">
                                                        Güncelle
                                                    </a>
                                                    <a asp-controller="ShipmentTracking"
                                                       asp-action="Index"
                                                       asp-route-trackingNumber="@item.TrackingNumber"
                                                       class="btn btn-sm btn-info">
                                                        Kargo Hareketleri
                                                    </a>
                                                    <a asp-controller="Shipment"
                                                       asp-action="DeleteShipment"
                                                       asp-route-id="@item.ShipmentId"
                                                       class="btn btn-sm btn-danger"
                                                       onclick="return confirm('Bu gönderiyi silmek istediğinizden emin misiniz?')">
                                                        Sil
                                                    </a>
                                                </td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                        <a asp-controller="Shipment"
                           asp-action="CreateShipment"
                           class="btn btn-success mt-3">
                            Yeni Gönderi Ekle
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
