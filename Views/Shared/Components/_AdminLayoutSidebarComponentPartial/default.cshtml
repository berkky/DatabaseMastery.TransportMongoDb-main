                    </a>
                </li>
                <li class="@MenuItemClass("About")">
                    <a asp-controller="About" asp-action="Aboutlist" class="@LinkClass("About")">
                        <i data-feather="info" aria-hidden="true"></i>
                        <span> Hakkımızda İşlemleri </span>
                    </a>
                </li>
                <li class="@MenuItemClass("HowItWorks")">
                    <a asp-controller="HowItWorks" asp-action="HowItWorkslist" class="@LinkClass("HowItWorks")">
