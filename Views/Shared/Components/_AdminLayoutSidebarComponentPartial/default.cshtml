@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;

    bool MenuActive(string controller) =>
        string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase) ||
        (string.Equals(controller, "Shipment", StringComparison.OrdinalIgnoreCase) &&
         string.Equals(currentController, "ShipmentTracking", StringComparison.OrdinalIgnoreCase));

    string MenuItemClass(string controller) => MenuActive(controller) ? "menuitem-active" : string.Empty;
    string LinkClass(string controller) => MenuActive(controller) ? "tp-link active" : "tp-link";
}

