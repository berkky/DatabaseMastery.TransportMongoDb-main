                        <img src="/Silva-Admin/dist/assets/images/logo-sm.png" alt="" height="22">
                    </span>
                    <span class="logo-lg">
                        <img src="/Silva-Admin/dist/assets/images/logo-light.png" alt="" height="24">
                    </span>
                </a>
                <a asp-controller="AdminLayout" asp-action="Index" class="logo logo-dark">
                    <span class="logo-sm">
                        <img src="/Silva-Admin/dist/assets/images/logo-sm.png" alt="" height="22">
                    </span>
                    <span class="logo-lg">
                        <img src="/Silva-Admin/dist/assets/images/logo-dark.png" alt="" height="24">
                    </span>
                </a>
            </div>

            <ul id="side-menu">

                <li class="menu-title">Menü</li>

            
                <li class="menu-title mt-2">Ana Sayfa Alanları</li>

                <li class="@MenuItemClass("Slider")">
                    <a asp-controller="Slider" asp-action="Sliderlist" class="@LinkClass("Slider")">
